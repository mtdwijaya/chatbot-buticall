# Salin file ini menjadi .env lalu isi nilai sebenarnya

# Token dari BotFather
BOT_TOKEN=1234567890:AAHxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Nomor WhatsApp admin
ADMIN_WA=08xxxxxxxxxx

# Web App URL dari Deploy Apps Script (lihat apps_script/README.md)
BOOKING_WEBHOOK_URL=https://script.google.com/macros/s/XXXX/exec

# Harus sama dengan BOOKING_SECRET di apps_script/Code.gs
BOOKING_SECRET=buticall-booking-secret-ganti

# Email tujuan notifikasi booking (dikirim lewat Apps Script)
ADMIN_EMAIL=admin@example.com
